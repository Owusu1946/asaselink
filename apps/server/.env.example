# Local API configuration. Keep this file secret-free.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asaselink
CORS_ORIGIN=http://localhost:3001

# Optional locally; required for authenticated API requests.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Private Cloudflare R2 bucket used for developer compliance documents.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=asaselink-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
